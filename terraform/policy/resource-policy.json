{
  "policy_version": "1.0",
  "project": "mays-orders",
  "description": "May's Orders Terraform Cost/Resource Policy Gate. Validates the Terraform plan against the project's explicitly agreed development governance limits.",
  "region": {
    "allowed_patterns": ["eu-central-*"]
  },
  "environment": {
    "developer_allowed": ["Development"],
    "production": {
      "allowed": false
    }
  },
  "required_tags": [
    "Project",
    "Maker",
    "Environment"
  ],
  "resource_types": {
    "allowed": [
      "aws_apigatewayv2_api",
      "aws_apigatewayv2_authorizer",
      "aws_apigatewayv2_integration",
      "aws_apigatewayv2_route",
      "aws_apigatewayv2_stage",
      "aws_cloudtrail",
      "aws_cloudwatch_dashboard",
      "aws_cloudwatch_log_group",
      "aws_cloudwatch_metric_alarm",
      "aws_cognito_user_group",
      "aws_cognito_user_pool",
      "aws_cognito_user_pool_client",
      "aws_dynamodb_table",
      "aws_iam_role",
      "aws_iam_role_policy",
      "aws_lambda_function",
      "aws_lambda_event_source_mapping",
      "aws_lambda_permission",
      "aws_s3_bucket",
      "aws_s3_bucket_ownership_controls",
      "aws_s3_bucket_policy",
      "aws_s3_bucket_public_access_block",
      "aws_s3_bucket_server_side_encryption_configuration",
      "aws_sqs_queue",
      "aws_sqs_queue_policy",
      "time_sleep",
      "terraform_data"
    ]
  },
  "ec2": {
    "allowed_instance_types": [
      "t3.micro",
      "t3.small",
      "t2.micro",
      "t2.small"
    ],
    "max_instances": 4,
    "max_ebs_gib": 20
  },
  "lambda": {
    "allowed_runtimes": ["python3.11", "python3.14"],
    "max_timeout_seconds": 10,
    "max_log_retention_days": 7
  },
  "dynamodb": {
    "allowed_billing_modes": ["PAY_PER_REQUEST"]
  },
  "s3": {
    "project_bucket_required": true,
    "require_public_access_block": true,
    "require_server_side_encryption": true
  },
  "cost_model": {
    "mode": "low-cost",
    "budget_alarm_is_monitoring_only": true,
    "note": "This gate enforces concrete resource limits. It is not a replacement for AWS Budgets and does not claim to calculate an exact AWS bill."
  }
}
