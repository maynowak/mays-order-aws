{
  "name": "mays-orders-lambda",
  "version": "0.1.0",
  "private": true,
  "description": "Order Handler Lambda fuer May's Orders (T011-04)",
  "main": "dist/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --minify --outfile=dist/index.js",
    "package": "npm run build && bestzip dist/lambda.zip dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "bestzip": "^2.2.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
